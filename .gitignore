# Household configuration and generated pages stay private.
/private/
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
/node_modules/
/artifacts/
/layout-editor.html

# Per-developer Spec Kit selection and agent state, never shared instructions.
/.specify/feature.json
/.claude/settings.local.json
/.claude/projects/
/.claude/sessions/
/.codex/auth.json
/.codex/config.toml
/.codex/history.jsonl
/.codex/sessions/
/.codex/log/
